# Same Supabase project as the root gateway. Required for persistent mode.
SUPABASE_URL=
# A publishable key or legacy anon key; used only by the server-side Auth client.
SUPABASE_ANON_KEY=
# Server-only secret. Never use a NEXT_PUBLIC_ name for this key.
SUPABASE_SECRET_KEY=
SESSION_SECRET=

# Root gateway on a separate port. INTERNAL_SERVICE_TOKEN must match the root.
FHIR_BASE_URL=http://localhost:4000/api/fhir/R4
NOTIFY_API_URL=http://localhost:4000/api/notify/v1
INTERNAL_SERVICE_TOKEN=
# Must match APP_BASE_URL in the root and the port used to run this frontend.
APP_BASE_URL=http://localhost:3000
CRON_SECRET=

VISIT_STORE=supabase
CLINICAL_SOURCE=fhir
BOOKING_ENABLED=false

# Swappable video: local for same-browser demos; twilio for multiple devices.
COMMS_PROVIDER=local
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Existing Cloudinary browser configuration. An unsigned upload preset is required.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
