# Copy to .env.local and fill in. Everything is optional for local demo mode.

# Signs doctor + patient session cookies. REQUIRED in production (any long random string).
SESSION_SECRET=

# ── Video provider ────────────────────────────────────────────────
# "local"  = free, zero-config demo: real WebRTC between two tabs of the same browser.
# "twilio" = Twilio Programmable Video (needs the three keys below).
COMMS_PROVIDER=local
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# ── Clinical data (patient chart) ────────────────────────────────
# "mock" = built-in synthetic FHIR records (default)
# "fhir" = the team's FHIR R4 gateway (root of this repo). Run it on another port:
#   (repo root) npm run dev -- -p 4000
CLINICAL_SOURCE=mock
FHIR_BASE_URL=http://localhost:4000/api/fhir/R4
# Which clinic the gateway should use (sent as X-Clinic-Id), e.g. demo-mock
FHIR_CLINIC_ID=demo-mock
# Required by the gateway: its INTERNAL_SERVICE_TOKEN (sent as Authorization: Bearer)
FHIR_API_KEY=

# ── Doctor sign-in ───────────────────────────────────────────────
# If both are set, doctors sign in with Supabase Auth (email must match a
# practitioner in src/lib/directory.ts). If unset, demo accounts are used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Allow demo accounts on a production build (e.g. a Vercel demo deploy).
ALLOW_DEMO_LOGIN=false

# Cloudinary browser uploads: use an unsigned preset. No API secret goes here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=hqhfgx5c
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default
